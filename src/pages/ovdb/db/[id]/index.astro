---
import OVDBDatabasePage from '../../../../components/OVDBDatabasePage.astro';
import SiteLayout from '../../../../layouts/SiteLayout.astro';
import { ovdbDatabases, storageGroups } from '../../../../data/ovdb';
import type { StorageEntry } from '../../../../data/ovdb';
import type { OVDBDatabase } from '../../../../data/types';

export function getStaticPaths() {
  return [
    ...ovdbDatabases.map((database) => ({ params: { id: database.localId }, props: { database } })),
    ...storageGroups.flatMap(({ database, storages }) => storages.map((storage) => ({
      params: { id: storage.id }, props: { database, storage },
    }))),
  ];
}

const { database, storage } = Astro.props as { database: OVDBDatabase; storage?: StorageEntry };
const isPublic = storage?.readiness === 'public-api';
const isGit = storage?.readiness === 'hosted-repository';
const canonical = `/ovdb/db/${storage?.id}/`;
const storageDescription = isPublic ? 'Public read-only OpenVaultDB API available.' : isGit ? 'Git-hosted inGitDB edition, ready to query locally.' : 'Hosted on Neon; public OpenVaultDB access pending.';
const cliInstructions = isGit ? `git clone https://github.com/demo-db/${database.localId}.git\ncd ${database.localId}\ngit checkout ${storage.revision}\ningitdb validate --path ingitdb\ningitdb list collections --path ingitdb\ningitdb select --path ingitdb --from <collection> --limit 10` : '';
---
{storage ? <SiteLayout title={`${database.title} · ${storage.engine} storage · DemoDB`} description={`${database.title} ${storage.engine} storage on DemoDB. ${storageDescription}`} canonical={canonical}>
  <section class="shell page-hero">
    <a class="back-link" href="/ovdb/">← Server and storage catalogue</a>
    <p class="eyebrow">{database.title} · {storage.engine}</p>
    <h1>{database.title}<br /><em>{storage.engine} storage</em></h1>
    <p class="hero-lede">{isPublic ? 'Published on the shared OpenVaultDB server with a public read-only API.' : isGit ? 'Published in the dataset’s GitHub repository as queryable inGitDB collections.' : 'The PostgreSQL copy is hosted on Neon. Public OpenVaultDB API access is being prepared.'}</p>
    <div class="storage-tags" aria-label="Storage tags">{storage.tags.map((tag) => <span class="storage-tag">{tag}</span>)}</div>
    <div class="hero-actions">
      {isPublic && <a class="button button-primary" href={database.apiUrl}>Open read-only API <span aria-hidden="true">↗</span></a>}
      {isGit && <a class="button button-primary" href={storage.repositoryUrl}>Browse inGitDB files <span aria-hidden="true">↗</span></a>}
      <a class="button button-quiet" href={database.homepage}>Explore dataset and schema <span aria-hidden="true">→</span></a>
      {isPublic && <a class="button button-quiet" href={`/ovdb/db/${database.localId}/ovdb-database.json`}>Database descriptor ↗</a>}
      {isGit && <a class="button button-quiet" href={storage.manifestUrl}>Export manifest ↗</a>}
    </div>
  </section>
  <section class="shell section intro-grid">
    <div><p class="eyebrow">Storage status</p><h2>{isPublic ? 'Available through OpenVaultDB.' : isGit ? 'Available in GitHub.' : 'Hosted copy, access pending.'}</h2></div>
    <div class="intro-copy">
      <p>{isPublic ? database.description : isGit ? `Explore the ${database.title} dataset as Git-backed inGitDB collections.` : `Explore the ${database.title} dataset in its hosted PostgreSQL edition.`}</p>
      <p>Storage ID: <code>{storage.id}</code>. Dataset ID: <code>{database.localId}</code>.</p>
      {isPublic ? <p>{database.recordsets.length} published collections. <a href={`/${database.localId}/`}>Browse tables and semantic references →</a></p> : isGit ? <p>Source tables are stored as inGitDB collections at the pinned repository revision <code>{storage.revision}</code>. The <a href={storage.manifestUrl}>export manifest</a> maps collections to native tables and documents keys, encodings, row counts, provenance, and source view SQL. Views are metadata only and cannot be queried as inGitDB collections.</p> : <p>Neon hosts this PostgreSQL edition of the dataset. A public endpoint and machine-readable OVDB descriptor have not been published yet. Browse the dataset site for its schema, provenance, and downloadable exports.</p>}
      {!isPublic && !isGit && database.localId === 'employees' && <p>This hosted copy uses the same browser edition: 1,024 selected employees and their employment history.</p>}
      {!isPublic && !isGit && database.localId === 'adventureworks' && <p>The PostgreSQL import stores <code>Production.Document.FileExtension</code> as <code>BYTEA</code> to preserve source NUL bytes. The linked dataset schema describes the source edition.</p>}
    </div>
  </section>
  {isGit && <section class="shell section"><div class="section-heading compact"><div><p class="eyebrow">Query locally</p><h2>Clone the pinned edition.</h2></div></div><p>Use the current inGitDB CLI to validate, list collections, and select records. Replace <code>&lt;collection&gt;</code> with a name from the list.</p><pre class="query-code"><code>{cliInstructions}</code></pre></section>}
</SiteLayout> : <OVDBDatabasePage database={database} />}

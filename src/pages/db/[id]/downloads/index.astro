---
import SiteLayout from '../../../../layouts/SiteLayout.astro';
import { databases } from '../../../../data/db';
import type { Database } from '../../../../data/types';
export function getStaticPaths() { return databases.map((db) => ({ params: { id: db.id }, props: { db } })); }
const { db } = Astro.props as { db: Database };
const fullFiles = db.exports.filter((item) => !item.table && item.format !== 'metadata');
const tables = db.tables.filter((item) => item.kind === 'table');
---
<SiteLayout db={db} title={`Downloads — ${db.name} | DemoDB`} description={`Download ${db.name} in the formats supported by its provider contract.`} canonical="/downloads/">
  <section class="page-intro shell"><p class="eyebrow">Data access</p><h1>Downloads</h1><p>Download the complete database or choose a focused table export. Every link is checked against the provider’s pinned checksum at build time.</p></section>
  <section class="shell section download-layout"><div><div class="section-heading compact"><div><p class="eyebrow">Complete database</p><h2>Files ready to use.</h2></div></div><div class="big-download-list">{fullFiles.map((item) => <a href={`/data/${item.publicPath}`} download><span><strong>{item.format.toUpperCase()}</strong><small>{item.bytes != null ? `${item.bytes.toLocaleString()} bytes · ` : ''}Complete {db.name} export</small></span><b>↓</b></a>)}</div><div class="content-card download-note"><p class="eyebrow">Machine-readable schema</p><h2>Use the contract too.</h2><p>Schema JSON describes native table and view names, columns, keys, relationships, sample rows, and row counts.</p><a class="text-link" href="/schema.json">Download schema JSON →</a></div></div><aside class="download-aside"><div class="content-card"><p class="eyebrow">Table files</p><h2>{tables.length} tables</h2><p>Each table uses its original identifier in the download name. URL encoding keeps names with spaces usable as ordinary links.</p><div class="mini-table-list">{tables.map((table) => <a href={`/tables/${encodeURIComponent(table.name)}/`}><span>{table.name}</span><small>{table.rowCount?.toLocaleString() ?? '—'} rows →</small></a>)}</div></div></aside></section>
</SiteLayout>

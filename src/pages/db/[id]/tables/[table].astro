---
import SiteLayout from '../../../../layouts/SiteLayout.astro';
import { quoteIdentifier } from '../../../../data/handoffs';
import QueryExamples from '../../../../components/QueryExamples.astro';
import TableActions from '../../../../components/TableActions.astro';
import MeaningLinks from '../../../../components/MeaningLinks.astro';
import { foreignKeyGroups, joinExamples, tableSelect } from '../../../../data/handoffs';
import { databases, publicDataPath, recordsetPath } from '../../../../data/db';
import { relatedRecordsets } from '../../../../data/similarity';
import type { Database, Recordset } from '../../../../data/types';
export function getStaticPaths() {
  return databases.flatMap((db) => db.tables.map((table) => ({ params: { id: db.id, table: table.name }, props: { db, table } })));
}
const { db, table } = Astro.props as { db: Database; table: Recordset };
const related = [...new Set(table.foreignKeys.map((fk) => fk.table))];
const inbound = db.tables.filter((candidate) => candidate.foreignKeys.some((fk) => fk.table === table.name));
const similar = relatedRecordsets(db, table, databases);
const previewColumns = table.columns.slice(0, 7);
const previewRows = table.rows.slice(0, 8);
const uniqueKeys = table.uniqueKeys ?? [];
const uniqueIndexes = table.uniqueIndexes ?? [];
const uniqueMetadataKnown = Array.isArray(table.uniqueKeys) && Array.isArray(table.uniqueIndexes);
const hasPrimaryKey = table.columns.some((column) => column.primaryKey);
const jsonUrl = publicDataPath(db, 'json', table.name);
const csvUrl = publicDataPath(db, 'csv', table.name);
const sqlUrl = publicDataPath(db, 'sql', table.name);
const yamlUrl = publicDataPath(db, 'yaml', table.name);
const hasSqlFixture = Boolean(publicDataPath(db, 'sqlite'));
const jsonlUrl = publicDataPath(db, 'jsonl', table.name);
const joins = hasSqlFixture ? joinExamples(db, table) : [];
const relations = foreignKeyGroups(table).map((keys) => ({ href: recordsetPath(keys[0].table), bindings: keys.map((key) => ({ local: key.column, remote: key.referencedColumn })) }));
const rowKeys = table.columns.filter((column) => column.primaryKey).map((column) => column.name);
const selectSql = tableSelect(table);
const hasGrid = Boolean(db.capabilities.datatug && jsonUrl);
---
<SiteLayout db={db} title={`${table.name} — ${db.name} schema | DemoDB`} description={`${table.description || `${table.name} ${table.kind} schema`} in ${db.name}: columns, keys, relationships, preview records, and downloads.`} canonical={recordsetPath(table.name)}>
  <section class="table-hero shell"><div><a class="back-link" href="/tables/">← All tables and views</a><h1>{table.name}</h1><p>{table.description || `Native ${table.kind} in the ${db.name} sample database.`}</p><p class="metadata-line"><span>{table.kind}</span><span>{table.rowCount?.toLocaleString() ?? 'Unknown'} rows</span><span>{table.columns.length} columns</span><span>{table.foreignKeys.length} declared foreign-key fields</span></p><TableActions db={db} table={table} /></div></section>
  <div class="shell"><nav class="table-section-nav" aria-label="Table sections"><a href="#data">Data</a><a href="#schema">Schema</a><a href="#relationships">Relationships</a><a href="#meanings">Meanings</a></nav></div>
  <section class="shell table-layout"><div class="table-main">
    <section id="data" class="content-card" data-table-explorer data-table={table.name} data-dataset={db.id} data-record-keys={JSON.stringify(rowKeys)}><div class="card-heading"><div><p class="eyebrow">Data</p><h2>Explore {table.name}</h2></div><span class="muted">{table.rowCount == null ? '' : `${table.rowCount.toLocaleString()} rows available`}</span></div><div data-static-preview>{previewRows.length ? <div class="preview-scroll"><table class="preview-table"><thead><tr>{previewColumns.map((column) => <th>{column.name}</th>)}</tr></thead><tbody>{previewRows.map((row) => <tr>{previewColumns.map((column) => <td>{row[column.name] == null ? <span class="null-value">NULL</span> : String(row[column.name])}</td>)}</tr>)}</tbody></table></div> : <p class="muted">This recordset has no sample rows.</p>}{jsonUrl && <div class="preview-actions"><a class="text-link" href={jsonUrl}>Open complete JSON data →</a>{csvUrl && <a class="text-link" href={csvUrl}>Download CSV ↓</a>}</div>}</div>
    {hasGrid && <><datatug-grid data-url={jsonUrl} data-decimal-columns={JSON.stringify(table.columns.filter((column) => column.decimal).map((column) => column.name))} data-relations={JSON.stringify(relations)} data-primary-key={JSON.stringify(rowKeys)} data-state-key="rows"></datatug-grid><noscript><p>Search, sorting and paging need JavaScript. The sample records and downloads above remain available.</p></noscript></>}
    <div class="context-actions"><TableActions db={db} table={table} compact /></div>
    {hasSqlFixture && <details class="utility-details"><summary>Starter SQL</summary><pre class="query-code"><code id="table-select-sql">{selectSql}</code></pre><button class="copy-button" data-copy-target="table-select-sql">Copy SQL</button></details>}
    {jsonlUrl && <p class="muted">This collection preserves original JSONL records. <a class="text-link" href={jsonlUrl} download>Download original JSONL ↓</a> · <a class="text-link" href="/model/">Read its field bindings →</a></p>}
    <section data-selected-record hidden aria-label="Selected record"><h3>Selected record</h3><dl data-record-fields></dl><a data-record-datatug data-handoff="datatug" data-dataset={db.id} data-object={table.name} hidden>Open this record in DataTug ↗</a></section>
    </section>
<QueryExamples db={db} table={table.name} compact />
      <section id="schema" class="content-card"><div class="card-heading"><h2>{table.columns.length} columns</h2><span class="muted">Schema from the provider contract</span></div><div class="schema-scroll"><table class="schema-table"><thead><tr><th>Column</th><th>Type</th><th>Nullable</th><th>Key</th><th>References</th><th>Meaning</th></tr></thead><tbody>{table.columns.map((column) => { const fks = table.foreignKeys.filter((fk) => fk.column === column.name); const keyColumns = table.columns.filter((candidate) => candidate.primaryKey); return <tr><th scope="row"><code>{column.name}</code>{hasSqlFixture && <button type="button" class="column-copy" data-copy-text={`SELECT ${quoteIdentifier(column.name)}\nFROM ${quoteIdentifier(table.name)}\nLIMIT 20;`} aria-label={`Copy SELECT SQL for ${column.name}`}>Copy SELECT</button>}</th><td><code>{column.type}</code>{column.decimal && <small class="decimal-note">Exact decimal · precision {column.decimal.precision}, scale {column.decimal.scale} · text storage</small>}</td><td>{column.nullable ? 'yes' : 'no'}</td><td>{column.primaryKey ? <span class="key-badge">PK{keyColumns.length > 1 ? ` ${column.primaryKeyPosition ?? keyColumns.indexOf(column) + 1}/${keyColumns.length}` : ''}</span> : '—'}</td><td>{fks.length ? fks.map((fk) => <a href={recordsetPath(fk.table)}><code>{fk.table}.{fk.referencedColumn}</code> </a>) : '—'}</td><td><MeaningLinks db={db} table={table.name} column={column.name} /></td></tr>; })}</tbody></table></div></section>
    {table.kind === 'table' && !hasPrimaryKey && <p class="muted key-status no-primary-key">No primary key is declared for this native table. The browser copy uses stable ordinal keys outside the source records.</p>}
    {table.kind === 'view' && table.viewSql && <div class="content-card"><div class="card-heading"><h2>View definition</h2></div><pre class="query-code"><code>{table.viewSql}</code></pre></div>}
    {table.kind === 'table' && uniqueMetadataKnown && <div class="content-card"><div class="card-heading"><h2>Keys and unique indexes</h2><span class="muted">Physical SQLite metadata</span></div><p class="muted key-status">{hasPrimaryKey ? 'Primary key is declared above.' : 'No primary key is declared; rows use export-order ordinals in the browser snapshot.'}</p>{uniqueKeys.length > 0 ? <div class="unique-list"><p class="eyebrow">Additional unique keys</p>{uniqueKeys.map((key) => <div class="unique-row"><code>{key.name}</code><span>{key.columns.join(' + ')}</span></div>)}</div> : <p class="muted key-status">{hasPrimaryKey ? 'No additional full-column unique key was found.' : 'No primary or additional full-column unique key was found.'}</p>}{uniqueIndexes.length > 0 ? <details class="index-details"><summary>{uniqueIndexes.length} unique index{uniqueIndexes.length === 1 ? '' : 'es'} inspected</summary>{uniqueIndexes.map((index) => <div class="unique-row"><code>{index.name}</code><span>{index.columns.map((column) => column.column ?? 'expression').join(' + ')}{index.partial ? ' · partial' : ''}</span>{index.sql && <code class="index-sql">{index.sql}</code>}</div>)}</details> : <p class="muted key-status">No unique SQLite indexes were found.</p>}</div>}
      </div><aside class="table-aside">
    <div class="content-card download-card"><p class="eyebrow">Download this recordset</p><h2>Choose a format</h2><div class="download-links">{jsonlUrl && <a href={jsonlUrl} download><span>Original JSONL</span><b>↓</b></a>}{jsonUrl && <a href={jsonUrl} download><span>JSON</span><b>↓</b></a>}{yamlUrl && <a href={yamlUrl} download><span>YAML</span><b>↓</b></a>}{csvUrl && <a href={csvUrl} download><span>CSV</span><b>↓</b></a>}{sqlUrl && <a href={sqlUrl} download><span>SQL</span><b>↓</b></a>}</div></div>
    <section id="relationships" class="content-card"><p class="eyebrow">Relationships</p><h2>Connected recordsets</h2>{related.length || inbound.length ? <div class="related-list">{related.map((name) => { const target=db.tables.find((item)=>item.name===name)!; return <div class="related-item"><a href={recordsetPath(name)}><span>→</span>{name}</a><details class="utility-details"><summary>Explore {name} with tools</summary><TableActions db={db} table={target} compact /></details></div>; })}{inbound.map((other) => <div class="related-item"><a href={recordsetPath(other.name)}><span>←</span>{other.name}</a><details class="utility-details"><summary>Explore {other.name} with tools</summary><TableActions db={db} table={other} compact /></details></div>)}</div> : <p class="muted">No declared foreign-key relationships.</p>}{joins.map((join, index) => <details class="utility-details"><summary>{join.title}</summary><TableActions db={db} table={join.target} compact /><pre class="query-code"><code id={`join-${index}`}>{join.sql}</code></pre><button class="copy-button" data-copy-target={`join-${index}`}>Copy join SQL</button></details>)}</section>
    {similar.length > 0 && <div class="content-card"><p class="eyebrow">Similar tables</p><h2>Across DemoDB</h2><p class="muted">Ranked by shared concepts, names, columns, and key shape.</p><div class="similar-list">{similar.map((match) => <article><a href={`https://${match.database.siteHost}${recordsetPath(match.table.name)}`}><strong>{match.table.name}</strong><span>{match.database.name} · {match.table.rowCount?.toLocaleString() ?? '—'} rows</span><small>{match.evidence.join(' · ')}</small></a><TableActions db={match.database} table={match.table} compact /></article>)}</div></div>}
    <section id="meanings" class="content-card"><p class="eyebrow">MeaningGraph</p><h2>What this table represents</h2><MeaningLinks db={db} table={table.name} /><a class="text-link" href="/model/#meanings-heading">All mapped concepts →</a></section><div class="content-card source-card"><p class="eyebrow">Provider</p><p>Schema and data come from the pinned database repository contract.</p><a class="text-link" href={`${db.sourceRepository.replace(/\.git$/, '')}/tree/${db.sourceCommit ?? 'main'}`}>View source →</a></div>
  </aside></section>
  {db.capabilities.datatug && jsonUrl && <script is:inline type="module" src="/embed/datatug.js"></script>}
</SiteLayout>
<style>
  .schema-scroll { margin-bottom:-25px; }
  .decimal-note { display:block; margin-top:4px; color:var(--faint); white-space:normal; }
  .schema-table tbody tr:last-child > * { border-bottom:0; }
  .preview-actions { display:flex; flex-wrap:wrap; gap:22px; margin-top:18px; }
  .unique-list,.index-details { margin-top:14px; }
  .key-status { font-size:12px; margin:8px 0; }
  .unique-row { display:grid; grid-template-columns:minmax(120px,1fr) minmax(0,2fr); gap:12px; border-top:1px solid var(--line); padding:10px 0; color:var(--muted); font-size:12px; }
  .unique-row code { color:var(--ink); overflow-wrap:anywhere; }
  .index-details > summary { color:var(--lime); cursor:pointer; font-size:12px; }
  .unique-row .index-sql { grid-column:1/-1; white-space:normal; }
  .similar-list { display:grid; gap:10px; margin-top:16px; }
  .similar-list a { border-top:1px solid var(--line); padding-top:10px; display:grid; gap:2px; }
  .similar-list strong { color:var(--ink); }
  .similar-list span,.similar-list small { color:var(--muted); font-size:11px; }
  .similar-list small { font-family:'DM Mono',monospace; line-height:1.5; }
  datatug-grid { display:block; min-height:240px; --datatug-bg:var(--panel); --datatug-fg:var(--ink); --datatug-muted:var(--muted); --datatug-border:var(--line); --datatug-header-bg:var(--panel-2); --datatug-hover:var(--hover-surface); --datatug-selected:var(--selected-surface); --datatug-accent:var(--lime); --datatug-button-bg:var(--panel-2); --datatug-error:var(--danger); --datatug-radius:0 0 7px 7px; }
</style>

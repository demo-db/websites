---
import type { Database } from '../data/types';
import MeaningEntity from './MeaningEntity.astro';
interface Props { db: Database; all?: boolean }
const { db, all = false } = Astro.props;
const concepts = all ? db.graph.concepts : db.graph.concepts.filter((concept) => concept.kind === 'entity' && concept.bindings.length > 0);
const visible = all ? concepts : concepts.slice(0,6);
---
<section class="shell section profile-meanings" aria-labelledby="meanings-heading">
 <div class="section-heading"><div><p class="eyebrow">MeaningGraph × {db.name}</p><h2 id="meanings-heading">The meaning behind the tables.</h2><p class="meaning-lede">Explore the {all ? 'concepts' : 'entities'} in this database and what they represent.</p></div><a class="text-link" href={db.graph.meaningHref}>Explore MeaningGraph ↗</a></div>
 {concepts.length ? <><ul class="meaning-list">{visible.map((concept) => <MeaningEntity db={db} concept={concept} />)}</ul>{!all && concepts.length > 6 && <details class="utility-details"><summary>Show {concepts.length - 6} more mapped entities</summary><ul class="meaning-list">{concepts.slice(6).map((concept) => <MeaningEntity db={db} concept={concept} />)}</ul></details>}</> : <p class="muted">No {all ? '' : 'entity '}concept bindings are published for these tables yet. <a href="/model/">Inspect the model and meaning files →</a></p>}
 {!all && <div class="meaning-actions"><a class="text-link" href="/model/#meanings-heading">View all mapped concepts →</a><a class="text-link" href="https://demodb.dev/concepts/">Compare concepts across datasets →</a><a class="text-link" href={db.graph.href}>Explore schema and meanings in CodeGrapher ↗</a></div>}
</section>
<style>.profile-meanings{padding-top:46px;border-top:1px solid var(--line)}.meaning-lede{max-width:650px;color:var(--muted);font-size:16px;margin:12px 0 0}.meaning-list{list-style:none;margin:0;padding:0;border-top:1px solid var(--line)}.meaning-actions{display:flex;flex-wrap:wrap;gap:24px;margin-top:24px}.meaning-actions a{font-size:13px;min-height:44px;display:flex;align-items:center}@media(max-width:680px){.section-heading{align-items:start;flex-direction:column;gap:16px}}</style>

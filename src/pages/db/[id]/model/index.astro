---
import DeveloperQuickstart from '../../../../components/DeveloperQuickstart.astro';
import ProfileMeanings from '../../../../components/ProfileMeanings.astro';
import SiteLayout from '../../../../layouts/SiteLayout.astro';
import { databases } from '../../../../data/db';
import type { Database } from '../../../../data/types';
export function getStaticPaths() { return databases.map((db) => ({ params: { id: db.id }, props: { db } })); }
const { db } = Astro.props as { db: Database };
const modelFiles = [db.model.hcl && { path: db.model.hcl, label: 'ModelSpec HCL' }, db.model.modelspec && { path: db.model.modelspec, label: 'ModelSpec JSON' }, db.meaning.file && { path: db.meaning.file, label: 'MeaningGraph file' }].filter((file): file is { path: string; label: string } => Boolean(file));
---
<SiteLayout db={db} title={`Model and meaning — ${db.name} | DemoDB`} description={`Provider-authored ModelSpec and MeaningGraph metadata for ${db.name}.`} canonical="/model/">
  <section class="page-intro shell"><p class="eyebrow">Model and meaning</p><h1>Data model</h1><p>The provider publishes storage-neutral descriptions alongside the native database schema. These files complement the schema pages and remain owned by the database repository.</p></section>
  <section class="shell section"><div class="download-layout"><div><div class="section-heading compact"><div><p class="eyebrow">Published files</p><h2>Provider-owned metadata.</h2></div></div><div class="big-download-list">{modelFiles.map((file) => <a href={`/model/${file.path.split('/').pop()}`}><span><strong>{file.label}</strong><small><code>{file.path}</code></small></span><b>↓</b></a>)}</div></div><aside class="download-aside"><div class="content-card"><p class="eyebrow">Bound to the schema</p><h2>{db.tables.filter((table) => table.kind === 'table').length} record types.</h2><p>The model files are generated and validated by the provider. Native recordset names continue to appear in table and download URLs.</p><a class="text-link" href="/schema/">Explore schema →</a></div></aside></div></section>
  <ProfileMeanings db={db} all />
  <DeveloperQuickstart db={db} />
</SiteLayout>

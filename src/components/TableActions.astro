---
import { tableActions } from '../data/handoffs';
import type { Database, Recordset } from '../data/types';
interface Props { db: Database; table: Recordset; compact?: boolean }
const { db, table, compact = false } = Astro.props;
---
<nav class:list={['table-actions', { compact }]} aria-label={`Explore ${table.name} with our tools`}>
  {tableActions(db, table).map((action) => <a href={action.href} data-handoff={action.product} data-dataset={db.id} data-object={table.name} title={action.detail} aria-label={`${action.label}: ${table.name} (${action.detail})`}>{action.label} <span aria-hidden="true">↗</span></a>)}
</nav>
<style>
.table-actions{display:flex;flex-wrap:wrap;gap:8px 18px;align-items:center}.table-actions a{display:inline-flex;align-items:center;gap:5px;min-height:44px;font-size:14px;font-weight:650;color:var(--cyan)}.table-actions.compact{border-top:1px solid var(--line);padding-top:9px;margin-top:auto;gap:4px 14px}.compact a{font-size:12px}@media(max-width:540px){.table-actions{gap:5px 14px}}
</style>

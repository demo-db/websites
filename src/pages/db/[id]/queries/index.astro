---
import SiteLayout from '../../../../layouts/SiteLayout.astro';
import { databases } from '../../../../data/db';
import type { Database } from '../../../../data/types';
export function getStaticPaths() { return databases.map((db) => ({ params: { id: db.id }, props: { db } })); }
const { db } = Astro.props as { db: Database };
const decimalRecordset = db.tables.find((table) => table.columns.some((column) => column.decimal));
const decimalColumn = decimalRecordset?.columns.find((column) => column.decimal);
const decimalScale = decimalColumn?.decimal?.scale ?? 0;
const supportsExactMoney = decimalScale <= 18;
const exactDecimalQuery = decimalRecordset && decimalColumn ? `from: {database: ${db.id}, name: '${decimalRecordset.name.replaceAll("'", "''")}', alias: source}\nmoney: {minorUnitScale: ${decimalScale}, divisionScale: ${decimalScale}, rounding: halfEven}\ncolumns:\n  - {aggregate: {function: sum, args: [{field: ${decimalColumn.name}, source: source}]}, as: Total}\n  - {aggregate: {function: avg, args: [{field: ${decimalColumn.name}, source: source}]}, as: Average}\n` : '';
---
<SiteLayout db={db} title={`Sample queries — ${db.name} | DemoDB`} description={`Useful SQL examples for exploring ${db.name}.`} canonical="/queries/">
  <section class="page-intro shell"><p class="eyebrow">Try a query</p><h1>Sample queries</h1><p>Start with a question about the data, then adapt the SQL for your own database engine.</p></section>
  <section class="shell section query-grid">{decimalRecordset && decimalColumn && db.ovdb.query && supportsExactMoney && <article class="content-card query-card"><p class="eyebrow">Exact decimals · hosted OVDB query</p><h2>Sum without floating-point loss</h2><p>Columns marked exact decimal are text-backed so their digits survive JSON and browser snapshots. Add the opt-in <code>money</code> settings to a hosted DTQL aggregate to calculate exact sums and averages with half-even rounding. The returned decimal values stay strings; the browser grid displays and sorts them without converting them to JavaScript numbers.</p><pre class="query-code"><code>{exactDecimalQuery}</code></pre><a class="text-link" href={db.ovdb.deploymentUrl}>Open the read-only OVDB explorer →</a></article>}{db.queries.map((query) => <article class="content-card query-card"><p class="eyebrow">{db.name}</p><h2>{query.title}</h2>{query.description && <p>{query.description}</p>}<pre class="query-code"><code>{query.sql}</code></pre><a class="text-link" href="/downloads/">Get the database →</a></article>)}</section>
</SiteLayout>
<style>.query-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:16px}.query-card{align-self:start}.query-card p:not(.eyebrow){color:var(--muted)}.query-code{white-space:pre-wrap;overflow-wrap:anywhere;color:var(--cyan);line-height:1.8;background:var(--code-surface);border:1px solid var(--line);border-radius:5px;padding:18px;font-size:12px;margin:20px 0}@media(max-width:800px){.query-grid{grid-template-columns:1fr}}</style>

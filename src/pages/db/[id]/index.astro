---
import SiteLayout from '../../../layouts/SiteLayout.astro';
import ExploreActions from '../../../components/ExploreActions.astro';
import DataTugLimits from '../../../components/DataTugLimits.astro';
import RecordsetCard from '../../../components/RecordsetCard.astro';
import { catalogueHost, completeDownloads, databaseById, databases, downloadLabel, exportHref, gapLabel, licenceNotice, unavailableFormats } from '../../../data/db';
import { exploreActions } from '../../../data/explore';
import { ovdbDatabaseById, postgresqlDataTugEditionId } from '../../../data/ovdb';
import { relatedRecordsets } from '../../../data/similarity';
import type { Database } from '../../../data/types';

export function getStaticPaths() { return databases.map((db) => ({ params: { id: db.id }, props: { db } })); }
const { db } = Astro.props as { db: Database };
const ovdbDatabase = ovdbDatabaseById.get(db.id);
const tables = db.tables.filter((table) => table.kind === 'table');
const views = db.tables.filter((table) => table.kind === 'view');
const totalRows = tables.reduce((sum, table) => sum + (table.rowCount ?? 0), 0);
const query = db.queries[0];
const primaryFile = db.exports.find((file) => file.table === null && file.format !== 'metadata');
const sourceLabel = primaryFile?.publicPath.split('/').at(-1) ?? db.name;
const explore = exploreActions(db, postgresqlDataTugEditionId(db.id));
const databaseMatches = tables.reduce((sum, table) => sum + relatedRecordsets(db, table, databases).length, 0);
---
<SiteLayout db={db} title={`${db.name} sample database | DemoDB`} description={db.description} canonical="/">
  <section class="hero shell db-hero">
    <div class="hero-copy"><a class="back-link" href={`https://${catalogueHost}/`}>All sample databases</a><p class="eyebrow"><span class="eyebrow-dot"></span>{db.domain} · {db.siteHost}</p><h1>{db.name}<br /><em>sample database.</em></h1><p class="hero-lede">{db.description}</p><div class="hero-actions"><ExploreActions actions={explore} /><a class={explore.primary ? 'button button-quiet' : 'button button-primary'} href="/downloads/">Download {db.name} <span aria-hidden="true">↓</span></a><a class="button button-quiet" href="/tables/">Browse tables <span aria-hidden="true">→</span></a></div></div>
    <div class="hero-console"><div class="console-bar"><span></span><span></span><span></span><code>{sourceLabel}</code></div><div class="console-content"><p class="console-comment">-- {query?.title ?? 'Explore the schema'}</p>{query ? <><p><span class="syntax-key">{query.sql.split(/\s+/)[0]}</span> {query.sql.split(/\s+/).slice(1, 5).join(' ')}</p><p class="console-result">{tables.length} tables · {views.length} views · {totalRows.toLocaleString()} rows</p></> : <p>{tables.length} tables · {views.length} views</p>}<div class="console-rule"></div><p class="console-comment">-- {databaseMatches} high-confidence cross-database table matches</p></div></div>
  </section>
  <section class="shell section db-summary"><div class="summary-stat"><strong>{tables.length}</strong><span>tables</span></div><div class="summary-stat"><strong>{views.length}</strong><span>views</span></div><div class="summary-stat"><strong>{totalRows.toLocaleString()}</strong><span>table rows</span></div><div class="summary-links"><a href="/schema/">Schema and relationships →</a><a href="/queries/">Sample queries →</a><a href="/about/">Source and licence →</a>{db.ovdb.available && ovdbDatabase && <a href={ovdbDatabase.id}>Explore in OpenVaultDB →</a>}</div></section>
  {db.relatedDatabases.length > 0 && <section class="shell section related-databases" aria-labelledby="related-databases-heading"><div class="section-heading compact"><p class="eyebrow">Dataset context</p><h2 id="related-databases-heading">Related databases</h2><p class="muted">Declared companion datasets and related fields. These links do not create foreign keys, automatic joins, or federation.</p></div><div class="table-grid">{db.relatedDatabases.map((relationship) => { const related = databaseById.get(relationship.databaseId)!; return <a class="table-card" href={related.canonicalUrl}><div class="table-card-top"><span class="table-icon">↗</span><span class="row-count">{relationship.kind}</span></div><strong>{related.name}</strong><span class="table-card-description">{relationship.description}</span><span class="table-card-columns">{relationship.local.recordset}.{relationship.local.field} ↔ {relationship.remote.recordset}.{relationship.remote.field}</span></a>; })}</div></section>}
  <section class="shell section"><div class="section-heading"><div><p class="eyebrow">Schema at a glance</p><h2>Browse the recordsets.</h2></div><a class="text-link" href="/tables/">All tables and views →</a></div><div class="table-grid">{db.tables.slice(0, 9).map((table) => <RecordsetCard recordset={table} relatedCount={relatedRecordsets(db, table, databases).length} />)}</div></section>
  {(explore.primary || explore.secondary.length > 0) && <DataTugLimits recordsets={db.tables} actions={explore} />}
  <section class="shell section format-section"><div class="format-panel"><div><p class="eyebrow">Downloads</p><h2>Use this fixture<br /><em>where you work.</em></h2><p>Provider files are checked against the provider’s pinned checksums; the complete JSON, YAML, PostgreSQL script, MySQL, SQL Server and Oracle scripts and inGitDB archive may be generated from those checked files or by DataTug, and are pinned by a lock; the matrix says which, per dataset. Pick a complete database or a single table.</p><p class="muted licence-notice">{licenceNotice(db)} <a href="/about/">Source and licence →</a></p></div><div class="format-list">{completeDownloads(db).slice(0, 12).map((file) => <a href={exportHref(file)}><span class="format-label">{downloadLabel(db, file.format)}</span><span>{file.table ?? 'Complete database'} <b>↓</b></span></a>)}</div></div></section>
  {unavailableFormats(db).length > 0 && <section class="shell section format-gaps" aria-labelledby="format-gaps-heading"><h2 id="format-gaps-heading">Formats not offered for {db.name}</h2><ul>{unavailableFormats(db).map((item) => <li><strong>{item.label}</strong><span>{gapLabel(item)}: {item.reason}</span></li>)}</ul><p class="muted"><a href="https://github.com/demo-db/websites/blob/main/docs/format-matrix.md">Coverage and validation matrix for every dataset →</a></p></section>}
</SiteLayout>

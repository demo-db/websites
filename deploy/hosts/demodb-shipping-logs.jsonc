// Assets-only host for the native inGitDB provider.
{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "demodb-shipping-logs",
  "compatibility_date": "2026-10-04",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "../../dist-hosts/shipping-logs.demodb.dev",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  },
  "routes": [{ "pattern": "shipping-logs.demodb.dev", "custom_domain": true }]
}

---
import SiteLayout from '../../../../layouts/SiteLayout.astro';
import { databases } from '../../../../data/db';
import type { Database } from '../../../../data/types';
export function getStaticPaths() { return databases.map((db) => ({ params: { id: db.id }, props: { db } })); }
const { db } = Astro.props as { db: Database };
---
<SiteLayout db={db} title={`Sample queries — ${db.name} | DemoDB`} description={`Useful SQL examples for exploring ${db.name}.`} canonical="/queries/">
  <section class="page-intro shell"><p class="eyebrow">Try a query</p><h1>Sample queries</h1><p>Start with a question about the data, then adapt the SQL for your own database engine.</p></section>
  <section class="shell section query-grid">{db.queries.map((query) => <article class="content-card query-card"><p class="eyebrow">{db.name}</p><h2>{query.title}</h2>{query.description && <p>{query.description}</p>}<pre class="query-code"><code>{query.sql}</code></pre><a class="text-link" href="/downloads/">Get the database →</a></article>)}</section>
</SiteLayout>
<style>.query-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:16px}.query-card{align-self:start}.query-card p:not(.eyebrow){color:var(--muted)}.query-code{white-space:pre-wrap;overflow-wrap:anywhere;color:var(--cyan);line-height:1.8;background:var(--code-surface);border:1px solid var(--line);border-radius:5px;padding:18px;font-size:12px;margin:20px 0}@media(max-width:800px){.query-grid{grid-template-columns:1fr}}</style>

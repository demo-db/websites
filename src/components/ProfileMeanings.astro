---
import type { Database } from '../data/types';
import { recordsetPath } from '../data/db';
interface Props { db: Database; all?: boolean }
const { db, all = false } = Astro.props;
const concepts = all ? db.graph.concepts : db.graph.concepts.filter((concept) => concept.kind === 'entity' && concept.bindings.length > 0);
const scopeLabel = (reference: string) => reference.split('?')[0].split('/').at(-1)?.replaceAll('-', ' ');
---
<section class="shell section profile-meanings" aria-labelledby="meanings-heading">
  <div class="section-heading"><div><p class="eyebrow">MeaningGraph × {db.name}</p><h2 id="meanings-heading">The meaning behind the tables.</h2><p class="meaning-lede">Explore the {all ? 'concepts' : 'entities'} in this database and what they represent.</p></div><a class="text-link" href={db.graph.meaningHref}>Explore MeaningGraph ↗</a></div>
  {concepts.length ? <ul class="meaning-list">{concepts.map((concept) => <li id={`concept-${concept.id}`}><div><a class="meaning-name" href={concept.definitionHref}>{concept.label} ↗</a><p>{concept.description}</p></div><div class="meaning-bindings"><span class="eyebrow">Mapped {concept.bindings.some((binding) => binding.column) ? 'tables and fields' : 'tables'}</span>{[...new Set(concept.bindings.map((binding) => `${binding.table}${binding.column ? `.${binding.column}` : ''}`))].map((label) => { const binding = concept.bindings.find((binding) => `${binding.table}${binding.column ? `.${binding.column}` : ''}` === label)!; return <a href={recordsetPath(binding.table)}>{label}</a>; })}</div><div class="meaning-scope">{concept.extends ? <><span>Extends {concept.extends.includes('://') ? 'shared' : 'local'} concept</span><strong>{scopeLabel(concept.extends)}</strong></> : concept.valuesOf ? <><span>Values of {concept.valuesOf.includes('://') ? 'shared' : 'local'} concept</span><strong>{scopeLabel(concept.valuesOf)}</strong></> : <span>{db.name} concept</span>}<a class="text-link" href={concept.definitionHref}>{concept.definitionLabel} ↗</a></div></li>)}</ul> : <p class="muted">No {all ? '' : 'entity '}concept bindings are published for these tables yet. <a href="/model/">Inspect the model and meaning files →</a></p>}
  {!all && <div class="meaning-actions"><a class="text-link" href="/model/#meanings-heading">View all mapped concepts →</a><a class="text-link" href={db.graph.href}>Explore schema and meanings in CodeGrapher ↗</a></div>}
</section>
<style>
.profile-meanings{padding-top:46px;border-top:1px solid var(--line)}.meaning-lede{max-width:650px;color:var(--muted);font-size:16px;margin:12px 0 0}.meaning-list{list-style:none;margin:0;padding:0;border-top:1px solid var(--line)}.meaning-list li{display:grid;grid-template-columns:minmax(0,2fr) minmax(0,1fr) minmax(0,1fr);gap:30px;padding:22px 0;border-bottom:1px solid var(--line);scroll-margin-top:90px}.meaning-name{font-size:18px;font-weight:700;color:var(--cyan)}.meaning-list p{margin:7px 0 0;color:var(--muted);font-size:14px;max-width:65ch;line-height:1.65}.meaning-bindings,.meaning-scope{display:flex;flex-direction:column;align-items:start;gap:7px;min-width:0;font-size:13px}.meaning-bindings a{overflow-wrap:anywhere;color:var(--cyan)}.meaning-bindings .eyebrow{font-size:9px;margin:0}.meaning-scope span{color:var(--muted)}.meaning-scope strong{text-transform:capitalize;font-weight:500}.meaning-scope .text-link{font-size:12px}.meaning-actions{display:flex;flex-wrap:wrap;gap:24px;margin-top:24px}.meaning-actions a{font-size:13px}@media(max-width:680px){.profile-meanings .section-heading{align-items:start;flex-direction:column;gap:16px}.meaning-list li{grid-template-columns:minmax(0,1fr);gap:14px}.meaning-bindings{flex-direction:row;flex-wrap:wrap;align-items:center}.meaning-scope{gap:5px}}
</style>

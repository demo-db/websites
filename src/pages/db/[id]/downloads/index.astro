---
import { readFile } from 'node:fs/promises';
import { resolve } from 'node:path';
import SiteLayout from '../../../../layouts/SiteLayout.astro';
import { databases } from '../../../../data/db';
import type { Database } from '../../../../data/types';
export function getStaticPaths() { return databases.map((db) => ({ params: { id: db.id }, props: { db } })); }
const { db } = Astro.props as { db: Database };
const snapshotManifest = JSON.parse(await readFile(resolve('public/research-snapshots', `${db.id}.manifest.json`), 'utf8'));
const snapshotParts = snapshotManifest.archive.parts as { file: string; bytes: number; sha256: string }[];
const fullFiles = db.exports.filter((item) => !item.table && item.format !== 'metadata');
const tables = db.tables.filter((item) => item.kind === 'table');
const transferLabel = (item: Database['exports'][number]) => item.compression === 'gzip' && item.decodedBytes != null
  ? `${item.decodedBytes.toLocaleString()} bytes file · ${item.bytes?.toLocaleString() ?? 'unknown'} gzip transfer`
  : item.bytes != null ? `${item.bytes.toLocaleString()} bytes` : null;
const importExports = db.exports.filter((item) => item.format === 'json' && item.table && tables.some((table) => table.name === item.table));
const canBrowserImport = tables.length > 0 && tables.every((table) => importExports.some((item) => item.table === table.name && item.sha256));
const importConfig = {
  id: db.id,
  sourceCommit: db.sourceCommit,
  tables: db.tables.map(({ name, kind, rowCount, columns, foreignKeys, modelEntity }) => ({ name, kind, rowCount, columns, foreignKeys, modelEntity })),
  exports: importExports.map((item) => ({ table: item.table, url: `/data/${item.publicPath}`, bytes: item.bytes, sha256: item.sha256, compression: item.compression, decodedBytes: item.decodedBytes, decodedSha256: item.decodedSha256 })),
};
---
<SiteLayout db={db} title={`Downloads — ${db.name} | DemoDB`} description={`Download ${db.name} in the formats supported by its provider contract.`} canonical="/downloads/">
  <section class="page-intro shell"><p class="eyebrow">Data access</p><h1>Downloads</h1><p>Download the complete database or choose a focused table export. Every link is checked against the provider’s pinned checksum at build time.</p></section>
  <section class="shell section download-layout"><div><div class="section-heading compact"><div><p class="eyebrow">Complete database</p><h2>Files ready to use.</h2></div></div><div class="big-download-list">{fullFiles.map((item) => <a href={`/data/${item.publicPath}`} download><span><strong>{item.format.toUpperCase()}</strong><small>{transferLabel(item) ? `${transferLabel(item)} · ` : ''}Complete {db.name} export</small></span><b>↓</b></a>)}</div><div class="content-card download-note"><p class="eyebrow">Machine-readable schema</p><h2>Use the contract too.</h2><p>Schema JSON describes native table and view names, columns, keys, relationships, sample rows, and row counts.</p><a class="text-link" href="/schema.json">Download schema JSON →</a><p><a class="text-link" href="https://demodb.dev/corpus.json">Open the machine-readable DemoDB corpus index →</a></p></div></div><aside class="download-aside"><div class="content-card"><p class="eyebrow">Table files</p><h2>{tables.length} tables</h2><p>Each table uses its original identifier in the download name. URL encoding keeps names with spaces usable as ordinary links.</p><div class="mini-table-list">{tables.map((table) => <a href={`/tables/${encodeURIComponent(table.name)}/`}><span>{table.name}</span><small>{table.rowCount?.toLocaleString() ?? '—'} rows →</small></a>)}</div></div></aside></section>

  <section class="shell section">
    <div class="content-card download-note">
      <p class="eyebrow">Reproducible research</p>
      <h2>One checked snapshot.</h2>
      <p>The deterministic bundle contains the checked table exports, schema, provider model files, licences, source revision, and example queries. Its manifest lists a SHA-256 checksum for every bundled file and archive part.</p>
      <div class="big-download-list">
        {snapshotParts.map((part, index) => <a href={`https://demodb.dev/research-snapshots/${part.file}`} download><span><strong>Research ZIP part {index + 1} of {snapshotParts.length}</strong><small>{part.bytes.toLocaleString()} bytes · SHA-256 {part.sha256}</small></span><b>↓</b></a>)}
        <a href={`https://demodb.dev/research-snapshots/${db.id}.manifest.json`}><span><strong>Bundle manifest</strong><small>Contents, source revision, and file checksums</small></span><b>↗</b></a>
        <a href={`https://demodb.dev/research-snapshots/${db.id}.zip.sha256`}><span><strong>Archive SHA-256</strong><small>Verify the downloaded ZIP</small></span><b>↗</b></a>
      </div>
      <p>Download every part, then concatenate them in numbered order to recreate the ZIP. The manifest lists each part checksum and the complete archive checksum.</p>
    </div>
  </section>

  <section class="shell section">
    <div class="content-card snapshot-import" data-import-root data-config={JSON.stringify(importConfig)}>
      <p class="eyebrow">Optional browser copy</p>
      <h2>Explore locally in this browser.</h2>
      <p>Import every physical table into this browser’s IndexedDB. Nothing is downloaded until you start. Views and the source files stay unchanged; the import is read-only.</p>
      <p class="muted">The importer verifies the decoded export checksum and declared row count before it activates the new local copy. It uses native primary keys when present; keyless rows are kept in provider JSON export order for local traversal.</p>
      <div class="snapshot-controls">
        <button class="button button-primary" type="button" data-action="start" disabled={!canBrowserImport}>Check storage and import</button>
        <button class="button" type="button" data-action="cancel" disabled>Cancel import</button>
        <button class="button" type="button" data-action="clear">Remove local copy</button>
      </div>
      <progress data-progress max="100" value="0" hidden></progress>
      <p class="snapshot-status" role="status" aria-live="polite" data-status>No local copy is active.</p>
      {!canBrowserImport && <p class="muted">A complete checked JSON export for every physical table is not published yet, so browser import is unavailable for this provider.</p>}
      <div class="snapshot-explorer" data-explorer hidden>
        <div class="snapshot-lookup">
          <label>Native table <select data-table></select></label>
          <label>Primary key value <input data-key placeholder='42 or ["A", 2]' /></label>
          <button class="button" type="button" data-action="lookup">Find record</button>
          <button class="button" type="button" data-action="browse">Browse first 50</button>
        </div>
        <p class="muted" data-key-help></p>
        <div data-results aria-live="polite"></div>
      </div>
    </div>
  </section>
</SiteLayout>

<script>
  import { activeSnapshot, cancelStagingImport, clearActiveSnapshot, estimateImportBytes, findNativeReferences, followNativeForeignKey, getNativeRecord, importSnapshot, stagingImportKey } from '../../../../scripts/indexeddb-snapshot';
  import type { ImportConfiguration, NativeTable } from '../../../../scripts/indexeddb-snapshot';

  const root = document.querySelector<HTMLElement>('[data-import-root]');
  if (root) {
    const configuration = JSON.parse(root.dataset.config ?? '{}') as ImportConfiguration;
    const status = root.querySelector<HTMLElement>('[data-status]')!;
    const progress = root.querySelector<HTMLProgressElement>('[data-progress]')!;
    const start = root.querySelector<HTMLButtonElement>('[data-action="start"]')!;
    const cancel = root.querySelector<HTMLButtonElement>('[data-action="cancel"]')!;
    const clear = root.querySelector<HTMLButtonElement>('[data-action="clear"]')!;
    const explorer = root.querySelector<HTMLElement>('[data-explorer]')!;
    const tableSelect = root.querySelector<HTMLSelectElement>('[data-table]')!;
    const keyInput = root.querySelector<HTMLInputElement>('[data-key]')!;
    const keyHelp = root.querySelector<HTMLElement>('[data-key-help]')!;
    const results = root.querySelector<HTMLElement>('[data-results]')!;
    const physicalTables = configuration.tables.filter((table) => table.kind === 'table');
    let activeDb: IDBDatabase | null = null;
    let controller: AbortController | null = null;

    for (const table of physicalTables) {
      const option = document.createElement('option');
      option.value = table.name;
      option.textContent = table.name;
      tableSelect.append(option);
    }
    const selectedTable = () => physicalTables.find((table) => table.name === tableSelect.value)!;
    const updateKeyHelp = () => {
      const keys = selectedTable().columns.filter((column) => column.primaryKey).sort((a, b) => (a.primaryKeyPosition ?? 0) - (b.primaryKeyPosition ?? 0)).map((column) => column.name);
      keyHelp.textContent = keys.length ? `Native key order: ${keys.join(', ')}. Use a JSON scalar for one key or a JSON array in that order for a composite key.` : 'This native table has no primary key. Use Browse first 50; imported rows keep stable ordinal keys outside the source records.';
      keyInput.disabled = keys.length === 0;
    };
    tableSelect.addEventListener('change', updateKeyHelp);
    updateKeyHelp();

    const showRows = (rows: { table: NativeTable; row: Record<string, unknown>; ordinal?: number }[]) => {
      results.replaceChildren();
      for (const entry of rows) {
        const block = document.createElement('details');
        const summary = document.createElement('summary');
        summary.textContent = `${entry.table.name}${entry.ordinal == null ? '' : ` · source row ${entry.ordinal + 1}`}`;
        const pre = document.createElement('pre');
        pre.textContent = JSON.stringify(entry.row, null, 2);
        block.append(summary, pre);
        for (const foreignKey of entry.table.foreignKeys) {
          const button = document.createElement('button');
          button.type = 'button';
          button.className = 'text-link snapshot-link';
          button.textContent = `Follow ${foreignKey.column} → ${foreignKey.table}.${foreignKey.referencedColumn}`;
          button.addEventListener('click', async () => {
            if (!activeDb) return;
            const target = await followNativeForeignKey(activeDb, configuration.tables, entry.table.name, entry.row, foreignKey);
            if (target) showRows([{ table: configuration.tables.find((table) => table.name === foreignKey.table)!, row: target }]);
            else status.textContent = `No referenced ${foreignKey.table} record was found.`;
          });
          block.append(button);
        }
        const inboundGroups = new Map<string, { source: NativeTable; constraint: number }>();
        for (const source of physicalTables) {
          for (const foreignKey of source.foreignKeys.filter((key) => key.table === entry.table.name)) {
            const constraint = foreignKey.constraint ?? 0;
            inboundGroups.set(`${source.name}:${constraint}`, { source, constraint });
          }
        }
        for (const { source, constraint } of inboundGroups.values()) {
          const button = document.createElement('button');
          button.type = 'button';
          button.className = 'text-link snapshot-link';
          button.textContent = `Find records in ${source.name} that reference this row`;
          button.addEventListener('click', async () => {
            if (!activeDb) return;
            const matches = await findNativeReferences(activeDb, configuration.tables, entry.table.name, entry.row, source.name, constraint);
            showRows(matches.map((row) => ({ table: source, row })));
          });
          block.append(button);
        }
        results.append(block);
      }
      if (!rows.length) results.textContent = 'No matching records.';
    };

    const refreshActive = async () => {
      activeDb?.close();
      activeDb = await activeSnapshot(configuration);
      explorer.hidden = !activeDb;
      if (activeDb) status.textContent = 'A verified local copy is ready. Views remain schema metadata and are not imported as tables.';
      start.textContent = sessionStorage.getItem(stagingImportKey(configuration.id)) ? 'Resume import' : activeDb ? 'Replace local copy' : 'Check storage and import';
    };

    start.addEventListener('click', async () => {
      if (controller) return;
      start.disabled = true;
      cancel.disabled = false;
      clear.disabled = true;
      progress.hidden = false;
      progress.value = 0;
      controller = new AbortController();
      try {
        const estimate = await estimateImportBytes(configuration);
        if (estimate.available != null && estimate.required > estimate.available) throw new Error(`This browser reports ${(estimate.available / 1024 / 1024).toFixed(1)} MiB available; the import needs about ${(estimate.required / 1024 / 1024).toFixed(1)} MiB including working space.`);
        status.textContent = `Importing ${configuration.id}; estimated storage ${(estimate.required / 1024 / 1024).toFixed(1)} MiB. Keep this tab open. A failed or cancelled import can be retried or removed.`;
        await importSnapshot(configuration, (item) => {
          const fraction = item.tableTotal ? (item.tableIndex + (item.rowTotal ? item.rows / item.rowTotal : 0)) / item.tableTotal : 0;
          progress.value = Math.min(100, fraction * 100);
          status.textContent = `${item.table}: ${item.rows.toLocaleString()}${item.rowTotal == null ? '' : ` / ${item.rowTotal.toLocaleString()}`} rows · ${(item.bytes / 1024).toFixed(0)} KiB read`;
        }, controller.signal);
        progress.value = 100;
        await refreshActive();
      } catch (error) {
        status.textContent = error instanceof DOMException && error.name === 'AbortError'
          ? 'Import paused. Verified tables are saved; the current table will be checked again on retry. Choose Resume import or Remove local copy.'
          : error instanceof Error ? error.message : 'Import failed. Verified tables are saved; retry or remove the partial copy.';
        start.textContent = sessionStorage.getItem(stagingImportKey(configuration.id)) ? 'Resume import' : 'Check storage and import';
      } finally {
        controller = null;
        start.disabled = false;
        cancel.disabled = true;
        clear.disabled = false;
      }
    });
    cancel.addEventListener('click', () => controller?.abort());
    clear.addEventListener('click', async () => {
      try {
        controller?.abort();
        activeDb?.close();
        activeDb = null;
        await cancelStagingImport(configuration);
        await clearActiveSnapshot(configuration);
        explorer.hidden = true;
        progress.hidden = true;
        progress.value = 0;
        status.textContent = 'The local copy and any partial import were removed.';
      } catch (error) {
        status.textContent = error instanceof Error ? error.message : 'Could not remove the local copy.';
      }
    });
    root.querySelector<HTMLButtonElement>('[data-action="lookup"]')!.addEventListener('click', async () => {
      if (!activeDb) return;
      const table = selectedTable();
      try {
        const key = JSON.parse(keyInput.value) as IDBValidKey;
        const row = await getNativeRecord(activeDb, configuration.tables, table.name, key);
        showRows(row ? [{ table, row }] : []);
      } catch (error) { status.textContent = error instanceof Error ? error.message : 'Enter a valid JSON key.'; }
    });
    root.querySelector<HTMLButtonElement>('[data-action="browse"]')!.addEventListener('click', async () => {
      if (!activeDb) return;
      const table = selectedTable();
      const physical = physicalTables;
      const storeName = `recordset-${physical.findIndex((item) => item.name === table.name)}`;
      const rows = await new Promise<{ row: Record<string, unknown>; ordinal?: number }[]>((resolve, reject) => {
        const transaction = activeDb!.transaction(storeName);
        const request = transaction.objectStore(storeName).openCursor();
        const found: { row: Record<string, unknown>; ordinal?: number }[] = [];
        request.onsuccess = () => {
          const cursor = request.result;
          if (!cursor || found.length >= 50) { resolve(found); return; }
          found.push({ row: cursor.value as Record<string, unknown>, ordinal: Array.isArray(cursor.key) ? undefined : typeof cursor.key === 'number' ? cursor.key : undefined });
          cursor.continue();
        };
        request.onerror = () => reject(request.error ?? new Error('Could not browse this table.'));
      });
      showRows(rows.map((entry) => ({ table, ...entry })));
    });
    void refreshActive().catch((error) => { status.textContent = error instanceof Error ? error.message : 'Could not open the local copy.'; });
  }
</script>

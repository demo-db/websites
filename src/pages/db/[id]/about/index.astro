---
import SiteLayout from '../../../../layouts/SiteLayout.astro';
import { databases } from '../../../../data/db';
import type { Database } from '../../../../data/types';
export function getStaticPaths() { return databases.map((db) => ({ params: { id: db.id }, props: { db } })); }
const { db } = Astro.props as { db: Database };
const source = db.source as { repository?: string; revision?: string; license?: string; licenseFile?: string; notes?: string; path?: string };
const sourceCommit = source.revision;
const sourceLink = source.repository;
const providerLink = `${db.sourceRepository}/tree/${db.sourceCommit ?? 'main'}`;
const license = source.license ?? 'See provider repository';
---
<SiteLayout db={db} title={`About ${db.name} — provenance and licence | DemoDB`} description={`Source, provenance, and licensing information for the ${db.name} sample database.`} canonical="/about/">
  <section class="page-intro shell"><p class="eyebrow">About this resource</p><h1>{db.name}, with provenance.</h1><p>{db.description} This site is generated from the provider contract and its pinned exports.</p></section>
  <section class="shell section about-grid"><article class="prose"><p class="eyebrow">The source</p><h2>Traceable data.</h2><p>{source.notes ?? 'The provider repository documents how this sample database was sourced and prepared.'}</p><div class="source-details"><div><span>Upstream revision</span><code>{sourceCommit?.slice(0, 12) ?? 'See source'}</code></div><div><span>Data licence</span><strong>{license}</strong></div><div><span>Recordsets</span><strong>{db.tables.length}</strong></div></div><p>{sourceLink && <a class="text-link" href={sourceLink}>Upstream project ↗</a>}</p><p><a class="text-link" href={providerLink}>DemoDB provider contract at {db.sourceCommit?.slice(0, 12) ?? 'default branch'} ↗</a></p>{source.licenseFile && <p><a class="text-link" href={`${providerLink}/${source.licenseFile}`}>Read the included licence ↗</a></p>}</article><aside class="content-card licence-card"><p class="eyebrow">Licence and ownership</p><h2>{license}</h2><p>Database licensing follows the upstream source recorded in the provider contract. The website does not change that licence.</p><p>Schema metadata, downloadable files, and relationships are validated against the provider’s pinned contract during the site build.</p><a class="text-link" href={`${db.sourceRepository}`}>Provider repository ↗</a></aside></section>
  <section class="shell section about-note"><p class="eyebrow">OpenVaultDB</p><h2>Connect to a read-only sample database.</h2><p>OVDB support is {db.ovdb.available ? 'declared by this provider' : 'not declared by this provider'}. The connection target is published in the database discovery document.</p>{db.ovdb.available && <a class="text-link" href={db.ovdb.url}>Open database connection details →</a>}</section>
</SiteLayout>
